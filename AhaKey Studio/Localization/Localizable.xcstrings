    "text.ce9e21020b26": {
      "comment": "AhaKeyStudioView — 麦克风 + 输入监控 + 辅助功能三个权限都得给。打开「权限诊断」可以一键跳到系统设置对应页。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风 + 输入监控 + 辅助功能三个权限都得给。打开「权限诊断」可以一键跳到系统设置对应页。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant Microphone, Input Monitoring and Accessibility access. Permission Diagnostics links to the relevant System Settings pages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイク、入力監視、アクセシビリティの3つすべてを許可してください。「権限診断」から対応するシステム設定ページを開けます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "麥克風 + 輸入監控 + 輔助功能三個權限都得給。開啟「權限診斷」可以一鍵跳到系統設定對應頁。"
          }
        }
      }
    },
