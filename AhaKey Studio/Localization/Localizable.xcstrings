    "text.4c8355db4128": {
      "comment": "DeviceInfoView — 当前由本 App 占用蓝牙，Agent 应处于未加载。请先在「蓝牙连接」中选中 Agent 后再启停守护进程。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前由本 App 占用蓝牙，Agent 应处于未加载。请先在「蓝牙连接」中选中 Agent 后再启停守护进程。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app currently owns Bluetooth, so the Agent should be unloaded. Select Agent under Bluetooth Connection before starting or stopping the daemon."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、本アプリがBluetoothを占有しており、Agentは未ロード状態である必要があります。「Bluetooth接続」でAgentを選択してから、守護プロセスを起動または停止してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前由本 App 佔用藍牙，Agent 應處於未載入。請先在「藍牙連線」中選中 Agent 後再啟停常駐程式。"
          }
        }
      }
    },
