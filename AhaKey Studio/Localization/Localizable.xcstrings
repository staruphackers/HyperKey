        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "60 秒内未检测到 CH582 ISP。请检查数据线，以及 BOOT（PB22）与 GND 的短接和上电顺序。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No CH582 ISP detected within 60 seconds. Check the data cable, the BOOT (PB22) to GND connection and the power-on sequence."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "60秒以内にCH582 ISPが検出されなかった場合は、データケーブル、およびBOOT（PB22）とGNDのショート接続と電源順序を確認してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "60 秒內未檢測到 CH582 ISP。請檢查資料線，以及 BOOT（PB22）與 GND 的短接和上電順序。"
          }
        }
      }
    },
