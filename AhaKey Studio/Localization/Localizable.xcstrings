    "text.371d65fc7db1": {
      "comment": "AppDelegate — 此时退出可能导致键盘无法启动。请等待烧录完成或明确失败后再退出 AhaKey Studio。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此时退出可能导致键盘无法启动。请等待烧录完成或明确失败后再退出 AhaKey Studio。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitting now may prevent the keyboard from starting. Wait until flashing finishes or reports a failure before quitting AhaKey Studio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このまま終了するとキーボードが起動できなくなる可能性があります。AhaKey Studioを終了する前に、書き込みが完了するか、明確に失敗するまで待ってください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此時退出可能導致鍵盤無法啟動。請等待燒錄完成或明確失敗後再退出 AhaKey Studio。"
          }
        }
      }
