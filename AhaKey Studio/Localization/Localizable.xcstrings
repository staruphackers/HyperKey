    "text.670773423831": {
      "comment": "AhaKeyStudioModels — 若需与「⌘↵ 接受 / ⌘⌫ 拒绝」等组合键一致，请在编辑器里为对应键加修饰，并在 Cursor 设置 → Keyboard Shortcuts 中绑成相同组合。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若需与「⌘↵ 接受 / ⌘⌫ 拒绝」等组合键一致，请在编辑器里为对应键加修饰，并在 Cursor 设置 → Keyboard Shortcuts 中绑成相同组合。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To use shortcuts such as ⌘↵ to accept or ⌘⌫ to reject, add modifiers in the editor and assign the same shortcuts in Cursor Settings → Keyboard Shortcuts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「⌘↵ 受け入れる / ⌘⌫ 拒否」などの組み合わせキーと一致する必要がある場合は、エディタで対応するキーに修飾を加え、Cursor設定 → Keyboard Shortcutsで同じ組み合わせに紐付けます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若需與「⌘↵ 接受 / ⌘⌫ 拒絕」等組合鍵一致，請在編輯器裡為對應鍵加修飾，並在 Cursor 設定 → Keyboard Shortcuts 中綁成相同組合。"
          }
        }
      }
    },
