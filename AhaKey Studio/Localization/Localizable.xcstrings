    "text.58e9d3250073": {
      "comment": "FirmwareFlasherView — 请勿拔线、关闭窗口或退出 App。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请勿拔线、关闭窗口或退出 App。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not unplug the cable, close this window or quit the app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ケーブルを抜いたり、このウィンドウを閉じたり、アプリを終了したりしないでください。"
          }
        },
        "zh-Hant": {
