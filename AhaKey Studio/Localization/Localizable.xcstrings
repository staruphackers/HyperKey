    "text.de06847f9fd8": {
      "comment": "AgentManager — 本 App 连接蓝牙，用于配置与同步。Agent 的 LaunchJob 在持有方为 App 时不会加载，避免抢连接。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本 App 连接蓝牙，用于配置与同步。Agent 的 LaunchJob 在持有方为 App 时不会加载，避免抢连接。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app owns Bluetooth for configuration and sync. The Agent LaunchJob stays unloaded while the app owns the connection."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリはBluetoothに接続されており、設定と同期に使用されます。AgentのLaunchJobは、所有者がアプリを所持している場合、ロードされず、接続を奪うのを防ぎます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本 App 連線藍牙，用於配置與同步。Agent 的 LaunchJob 在持有方為 App 時不會載入，避免搶連線。"
          }
        }
      }
    },
