    "text.2f00ca52519e": {
      "comment": "UnifiedAhaKeyOnboardingView — 先完成蓝牙、麦克风、语音转写等弹窗授权，再依次开启 Siri、听写、辅助功能，最后处理输入监控并重启。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先完成蓝牙、麦克风、语音转写等弹窗授权，再依次开启 Siri、听写、辅助功能，最后处理输入监控并重启。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Bluetooth, microphone and speech recognition in the prompts, then enable Siri, Dictation and Accessibility. Enable Input Monitoring last and restart."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずBluetooth、マイク、音声認識などのダイアログで許可し、続いてSiri、音声入力、アクセシビリティを有効にします。最後に入力監視を有効にして再起動してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先完成藍牙、麥克風、語音轉寫等彈出視窗授權，再依次開啟 Siri、聽寫、輔助功能，最後處理輸入監控並重啟。"
          }
        }
      }
    },
