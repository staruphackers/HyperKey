    "text.53d0af2fae78": {
      "comment": "AhaKeyStudioView — 打开系统蓝牙，用于发现、连接和同步 AhaKey 键盘。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开系统蓝牙，用于发现、连接和同步 AhaKey 键盘。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Bluetooth to discover, connect to and sync AhaKey keyboards."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムBluetoothをオンにして、AhaKeyキーボードを検出、接続、同期します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟系統藍牙，用於發現、連線和同步 AhaKey 鍵盤。"
          }
        }
      }
    },
