    "text.283962e43cc8": {
      "comment": "AgentManager — 仅 Agent 连接蓝牙。Claude/Cursor/Codex/Kimi Code CLI Hook 才能驱动灯条与拨杆查询；本 App 里无法对键盘发 BLE 命令。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅 Agent 连接蓝牙。Claude/Cursor/Codex/Kimi Code CLI Hook 才能驱动灯条与拨杆查询；本 App 里无法对键盘发 BLE 命令。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the Agent connects to Bluetooth. Claude/Cursor/Codex/Kimi CLI hooks can control the light bar and query the switch; this app cannot send BLE commands directly."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetoothに接続できるのはAgentだけです。Claude/Cursor/Codex/KimiのCLI Hookからライトバーを制御し、スイッチの状態を取得できます。このアプリからキーボードへBLEコマンドを直接送信することはできません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅 Agent 連線藍牙。Claude/Cursor/Codex/Kimi Code CLI Hook 才能驅動燈條與撥桿查詢；本 App 裡無法對鍵盤發 BLE 命令。"
          }
        }
      }
    },
