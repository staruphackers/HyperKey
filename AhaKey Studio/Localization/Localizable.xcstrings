    "text.ec0a7ed5f35a": {
      "comment": "AhaKeyStudioView — 手动批准：会交回用户/终端确认。若 Cursor、Codex 或 Kimi 仍弹窗，请看 diagnostics 里的 ide 与 diagnostic 字段。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手动批准：会交回用户/终端确认。若 Cursor、Codex 或 Kimi 仍弹窗，请看 diagnostics 里的 ide 与 diagnostic 字段。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manual approval returns confirmation to the user or terminal. If Cursor, Codex or Kimi still shows prompts, inspect the ide and diagnostic fields in diagnostics."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手動承認：ユーザーまたは端末に確認を返します。Cursor、Codex、Kimiにまだプロンプトが表示される場合は、diagnostics内のideとdiagnosticsフィールドを確認してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手動批准：會交回使用者/終端確認。若 Cursor、Codex 或 Kimi 仍彈出視窗，請看 diagnostics 裡的 ide 與 diagnostic 欄位。"
          }
        }
      }
    },
    "text.ec187e57ee49": {
      "comment": "AhaKeyStudioModels — 针对 Cursor Composer / Agent：Key2 发 ↵、Key3 发 ⌫（与裸键一致）。",
