    "text.451ada5d9d6b": {
      "comment": "AhaKeyStudioView — 最新固件中 0x91 已用于灯效预览。虚拟拨杆只作为 Hook 软件覆盖，不再写入键盘 sw_state。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最新固件中 0x91 已用于灯效预览。虚拟拨杆只作为 Hook 软件覆盖，不再写入键盘 sw_state。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current firmware uses 0x91 for lighting previews. The virtual switch only overrides hook behavior and does not write keyboard sw_state."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新ファームウェアでは、0x91がライトエフェクトのプレビューに使用されています。仮想スイッチはHookの動作だけを切り替え、キーボードのsw_stateには書き込みません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
