        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 原生语音默认 F18；Typeless / 微信的 Fn 触发使用 F19。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS speech recognition defaults to F18; Typeless / WeChat Fn triggering uses F19."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSのデフォルト音声はF18です；Typeless / WeChatのFnキーでF19をトリガーして使用します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 原生語音預設 F18；Typeless / 微信的 Fn 觸發使用 F19。"
