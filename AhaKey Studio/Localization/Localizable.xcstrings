    "text.9a7a0997682e": {
      "comment": "DeviceInfoView — 同一时间只能由本 App 或 Agent 其中之一连接键盘，请在此切换。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
