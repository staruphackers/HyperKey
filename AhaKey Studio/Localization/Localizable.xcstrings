        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2.音声キーはまずデフォルトを選択し、他のキーは必要に応じてメニューキーまたはマクロキーを選択します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 語音鍵先選預設；其他鍵按需選單鍵或巨集。"
          }
        }
      }
    },
