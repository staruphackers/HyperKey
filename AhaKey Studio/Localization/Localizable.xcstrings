    "hyperkey.install.confirm.body": {
      "comment": "HyperKey install confirmation body. Keep file paths unchanged.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将写入：\n• ~/Library/LaunchAgents/tw.xlabs.hyperkey.agent.plist\n• ~/.claude/settings.json（状态类 Hook，不含权限请求）\n• ~/.codex/config.toml（同上）\n\n不会自动放行任何 AI 工具权限。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will write:\n• ~/Library/LaunchAgents/tw.xlabs.hyperkey.agent.plist\n• ~/.claude/settings.json (status hooks only, no permission requests)\n• ~/.codex/config.toml (same)\n\nAI tool permissions are never approved automatically."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のファイルに書き込みます：\n• ~/Library/LaunchAgents/tw.xlabs.hyperkey.agent.plist\n• ~/.claude/settings.json（ステータス用フックのみ、権限リクエストは含みません）\n• ~/.codex/config.toml（同上）\n\nAI ツールの権限が自動で許可されることはありません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將寫入：\n• ~/Library/LaunchAgents/tw.xlabs.hyperkey.agent.plist\n• ~/.claude/settings.json（狀態類 Hook，不含權限請求）\n• ~/.codex/config.toml（同上）\n\n不會自動放行任何 AI 工具權限。"
          }
        }
      }
    },
