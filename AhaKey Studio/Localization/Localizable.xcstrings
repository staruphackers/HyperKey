    "text.c3c9b5febf44": {
      "comment": "AhaKeyFirmwareFlasher — 烧录在擦除开始后中断。设备可能没有可运行固件，请保持 USB ISP 连接并重新烧录。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "烧录在擦除开始后中断。设备可能没有可运行固件，请保持 USB ISP 连接并重新烧录。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flashing was interrupted after erasing began. The device may have no bootable firmware. Keep USB ISP connected and flash again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "消去開始後に書き込みが中断されました。デバイスに実行可能なファームウェアがない可能性がありますので、USB ISP接続を維持して書き込みを再開してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "燒錄在擦除開始後中斷。裝置可能沒有可執行韌體，請保持 USB ISP 連線並重新燒錄。"
          }
        }
      }
