    "text.263c52f8c147": {
      "comment": "AhaKeyStudioView — 切换方式：键盘上的 Mode 拨杆，或主 App 顶部 Picker，或点画布上的 Mode 按钮。三处任一改动会同步另外两个。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换方式：键盘上的 Mode 拨杆，或主 App 顶部 Picker，或点画布上的 Mode 按钮。三处任一改动会同步另外两个。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch modes using the keyboard's Mode control, the app's top picker or the canvas Mode button. Changing one syncs the other two."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り替え方法：キーボードのModeスイッチ、メインアプリ上部のセレクター、またはキャンバス上のModeボタンで切り替えます。いずれか1か所を変更すると、他の2か所も同期します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換方式：鍵盤上的 Mode 撥桿，或主 App 頂部 Picker，或點畫布上的 Mode 按鈕。三處任一改動會同步另外兩個。"
          }
        }
      }
    },
