    "text.90eef5738329": {
      "comment": "FirmwareFlasherView — 设备可能已被擦除；请保持 USB ISP 连接，确认固件有效后重新烧录。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备可能已被擦除；请保持 USB ISP 连接，确认固件有效后重新烧录。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device may have been erased. Keep USB ISP connected, confirm the firmware is valid and flash again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスが消去されている可能性があります。USB ISP接続を維持し、ファームウェアが有効であることを確認してから再書き込みしてください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置可能已被擦除；請保持 USB ISP 連線，確認韌體有效後重新燒錄。"
          }
        }
      }
    },
