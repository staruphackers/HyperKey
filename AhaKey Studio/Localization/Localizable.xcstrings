    "text.796c1d6a471c": {
      "comment": "AhaKeyFirmwareFlasher — 所选固件在校验后发生了变化，已在访问设备前停止。请重新选择并确认 SHA-256。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选固件在校验后发生了变化，已在访问设备前停止。请重新选择并确认 SHA-256。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected firmware changed after validation. Stopped before accessing the device. Select it again and confirm its SHA-256."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したファームウェアは検証後に変更され、アクセスデバイス前に停止しました。再選択してSHA-256を確認してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選韌體在校驗後發生了變化，已在存取裝置前停止。請重新選擇並確認 SHA-256。"
          }
        }
      }
    },
