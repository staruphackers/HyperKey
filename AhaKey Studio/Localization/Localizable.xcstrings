    "text.6c7011111614": {
      "comment": "AhaKeyStudioView — 若仍出现手动：在「设备信息」里打开「工具批准诊断」查看 permission-request.log（含 ide、hookEvent、diagnostic 等）。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若仍出现手动：在「设备信息」里打开「工具批准诊断」查看 permission-request.log（含 ide、hookEvent、diagnostic 等）。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If manual prompts persist, open tool approval diagnostics in Device Information and inspect permission-request.log (ide, hookEvent, diagnostic and other fields)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手動の確認が引き続き表示される場合は、「デバイス情報」で「ツール許可診断」を開いてpermission-request.log（ide、hookEvent、diagnosticなどを含む）を確認してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若仍出現手動：在「裝置資訊」裡開啟「工具批准診斷」檢視 permission-request.log（含 ide、hookEvent、diagnostic 等）。"
          }
        }
      }
    },
