    "text.8ecb0d8fd20c": {
      "comment": "UnifiedAhaKeyOnboardingView — 允许 AhaKey Studio 在后台监听实体语音键；设置完成后通常需要退出并重新打开。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 AhaKey Studio 在后台监听实体语音键；设置完成后通常需要退出并重新打开。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow AhaKey Studio to listen for the physical voice key in the background. You usually need to quit and reopen the app afterward."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AhaKey Studioがバックグラウンドで物理音声キーを監視できるようにします。設定後は通常、アプリを終了して再起動する必要があります。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許 AhaKey Studio 在背景監聽實體語音鍵；設定完成後通常需要退出並重新開啟。"
          }
        }
      }
    },
