    "text.576389d100d8": {
      "comment": "AhaKeyStudioView — 虚拟拨杆不再占用 0x91，避免与最新固件的灯效预览命令冲突。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "虚拟拨杆不再占用 0x91，避免与最新固件的灯效预览命令冲突。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The virtual switch no longer uses 0x91, avoiding conflicts with the firmware lighting preview command."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仮想スイッチは0x91を占有しなくなりました。最新ファームウェアの点灯効果プレビュー命令と競合しないようにします。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "虛擬撥桿不再佔用 0x91，避免與最新韌體的燈效預覽命令衝突。"
          }
        }
      }
    },
    "text.5794e8df1dd1": {
