          "stringUnit": {
            "state": "translated",
            "value": "设备 LCD 只稳定支持 ASCII。中文、emoji 和全角字符会在写入时被自动过滤，避免乱码。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device LCD reliably supports ASCII only. Chinese, emoji and full-width characters are filtered before writing to avoid garbled text."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスLCDはASCIIのみを安定してサポートしています。中国語、emoji、全角文字は入力時に自動的にフィルタリングされ、乱字を防ぎます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置 LCD 只穩定支援 ASCII。中文、emoji 和全形字元會在寫入時被自動過濾，避免亂碼。"
          }
        }
      }
