    "text.fad8799c7c3e": {
      "comment": "AhaKeyStudioView — 语音键预设会固定使用单键绑定；如需录制宏，请先把预设改为自定义快捷键。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音键预设会固定使用单键绑定；如需录制宏，请先把预设改为自定义快捷键。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice presets use a single-key binding. Choose Custom Shortcut before recording a macro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声キーのプリセットは単キーバインドに固定されます。マクロ録音が必要な場合は、プリセットをカスタムキーに設定してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語音鍵預設會固定使用單鍵繫結；如需錄製巨集，請先把預設改為自定義快捷鍵。"
          }
        }
      }
    },
