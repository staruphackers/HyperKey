    "text.7e7c6026b367": {
      "comment": "DeviceInfoView — 已由本 App 占用蓝牙：要让 Agent 接管，请将「蓝牙连接」选为 hyperkey-agent。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已由本 App 占用蓝牙：要让 Agent 接管，请将「蓝牙连接」选为 hyperkey-agent。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app owns Bluetooth. Select hyperkey-agent under Bluetooth Connection to hand it over."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本アプリがBluetoothを占有しています：Agentに管理を任せるには、「Bluetooth接続」をhyperkey-agentに選択してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已由本 App 佔用藍牙：要讓 Agent 接管，請將「藍牙連線」選為 hyperkey-agent。"
          }
        }
      }
    },
    "text.7faf68ce4089": {
      "comment": "AhaKeyStudioModels — 默认用红色常亮停住。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
