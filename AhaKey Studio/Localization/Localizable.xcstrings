    "text.6310d26dc60c": {
      "comment": "AhaKeyStudioView — 切换 Mode 时 LCD 会先闪一下当前按键 description 文本（机械感效果），约 1 秒后回到该 Mode 的动图。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换 Mode 时 LCD 会先闪一下当前按键 description 文本（机械感效果），约 1 秒后回到该 Mode 的动图。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When switching modes, the LCD briefly shows the key description text, then returns to the mode animation after about one second."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Modeを切り替えると、LCDが現在のキー description テキスト（機械的な質感効果）を先に点滅させ、約1秒後にそのModeのアニメーションに戻ります。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換 Mode 時 LCD 會先閃一下當前按鍵 description 文本（機械感效果），約 1 秒後回到該 Mode 的動圖。"
          }
        }
      }
    },
