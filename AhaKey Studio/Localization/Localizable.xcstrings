    "text.923d6cc355ba": {
      "comment": "AgentManager — 已删除内存中的 AhaKey 条目，但**无法写回** %@。请检查对「用户目录下 .cursor」的写权限，或关闭占用该文件的其他应用后重试。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已删除内存中的 AhaKey 条目，但**无法写回** %@。请检查对「用户目录下 .cursor」的写权限，或关闭占用该文件的其他应用后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removed AhaKey entries in memory, but could not write %@. Check write access to ~/.cursor or close other apps using the file and retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモリ内のAhaKeyエントリは削除されましたが、%@に**書き戻すことはできません**。 「ユーザーディレクトリの .cursor」に対する書き込み権限を確認するか、このファイルを占有している他のアプリケーションを閉じてから再度お試しください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已刪除記憶體中的 AhaKey 條目，但**無法寫回** %@。請檢查對「使用者目錄下 .cursor」的寫權限，或關閉佔用該檔案的其他應用後重試。"
          }
        }
      }
    },
