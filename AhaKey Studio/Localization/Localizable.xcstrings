          "stringUnit": {
            "state": "translated",
            "value": "仍有权限未开启。请按上方状态逐项处理，全部变为绿色后再关闭弹窗。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some permissions are still disabled. Complete each item above and close this dialog once all indicators are green."
          }
