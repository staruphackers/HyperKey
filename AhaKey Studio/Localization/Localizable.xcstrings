    "text.5c9850140124": {
      "comment": "AhaKeyStudioView — 将先退出本应用，再自动重新打开。重新打开后「重新检查权限」会读取最新系统状态。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将先退出本应用，再自动重新打开。重新打开后「重新检查权限」会读取最新系统状态。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app will quit and reopen automatically. Check Permissions Again will then read the latest system state."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを終了して自動的に再起動します。再起動後、「権限を再確認」を選ぶと最新のシステム状態を読み取ります。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將先退出本應用，再自動重新開啟。重新開啟後「重新檢查權限」會讀取最新系統狀態。"
          }
        }
      }
    },
