    "text.f333efeccbf9": {
      "comment": "CloudAccountManager — 云端连接失败：TLS/SSL 校验未通过，请检查系统时间、网络代理/证书，或确认云端 HTTPS 证书配置正常。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云端连接失败：TLS/SSL 校验未通过，请检查系统时间、网络代理/证书，或确认云端 HTTPS 证书配置正常。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not connect: TLS/SSL verification failed. Check the system clock, network proxy and certificates, or the server HTTPS configuration."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウド接続失敗：TLS/SSL 検証に失敗しました。システム時刻、ネットワークプロキシや証明書を確認するか、クラウドのHTTPS証明書の構成が正常であることを確認してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雲端連線失敗：TLS/SSL 校驗未通過，請檢查系統時間、網路代理/證書，或確認雲端 HTTPS 證書配置正常。"
          }
        }
      }
    },
