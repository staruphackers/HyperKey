          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Planned. Firmware updates currently require USB ISP (opening the device, connecting BOOT and using wchisp). See the repository documentation for details."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "計画中です。次のバージョンで対応予定です。現在、すべてのファームウェア更新にはUSB-ISP（デバイスを開けてBOOTを短絡し、wchispを使用）が必要です。詳細はリポジトリのdocsを参照してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "規劃中，下一版本會做。當前所有韌體升級都需要 USB-ISP（拆機短 BOOT + wchisp）。詳細方案在倉庫 docs 裡。"
          }
        }
      }
    },
