    "text.2af44c9e0fc4": {
      "comment": "1: required frame count; 2: approximate total device frame capacity. Plural selection uses argument 1 (Int). Translate the full sentence; positional placeholders may reorder arguments.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "动画需要 %lld 帧，但设备当前没有足够连续空间。总容量上限约为 %lld 帧。"
                    }
                  }
                }
              }
            }
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "The animation needs %1$lld frame, but the device lacks contiguous space. Total frame capacity: approximately %2$lld."
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "The animation needs %1$lld frames, but the device lacks contiguous space. Total frame capacity: approximately %2$lld."
                    }
                  }
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "アニメーションには %lld フレームが必要です。しかし、デバイスには現在十分な連続空間がありません。総容量上限は約 %lld フレームです。"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "動畫需要 %lld 影格，但裝置當前沒有足夠連續空間。總容量上限約為 %lld 影格。"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "text.2af8cd09a077": {
      "comment": "UnifiedAhaKeyOnboardingView — 已授权，但系统蓝牙当前关闭，请在控制中心或系统设置中打开。",
      "extractionState": "manual",
