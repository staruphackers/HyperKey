            "value": "同一时间只能由本 App 或 Agent 其中之一连接键盘，请在此切换。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only this app or the Agent can connect to the keyboard at a time. Choose the connection owner here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ時間に本アプリまたはエージェントのいずれかからキーボードに接続できるため、ここで切り替えてください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同一時間只能由本 App 或 Agent 其中之一連線鍵盤，請在此切換。"
          }
