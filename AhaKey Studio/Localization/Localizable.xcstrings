    "text.82cb40f8cc56": {
      "comment": "AgentManager — Agent 已安装但未能启动，已临时由 App 直接连接键盘。请在「更多 → 设备信息 · Agent」里检查或重新安装 Agent。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent 已安装但未能启动，已临时由 App 直接连接键盘。请在「更多 → 设备信息 · Agent」里检查或重新安装 Agent。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Agent is installed but could not start. The app temporarily connected directly. Check or reinstall the Agent under More → Device Information · Agent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentはインストールされていますが起動できません。Appからキーボードに一時的に接続されています。「もっと見る → デバイス情報 · Agent」でAgentを確認または再インストールしてください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent 已安裝但未能啟動，已臨時由 App 直接連線鍵盤。請在「更多 → 裝置資訊 · Agent」裡檢查或重新安裝 Agent。"
          }
        }
