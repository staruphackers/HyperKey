    "text.298a41613998": {
      "comment": "AhaKeyStudioView — 只要 AhaKey Studio 在后台运行，Mode 1 出厂语音键发出的 F18 就会被直接接管到苹果原生转写。现在不再依赖系统听写快捷键。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只要 AhaKey Studio 在后台运行，Mode 1 出厂语音键发出的 F18 就会被直接接管到苹果原生转写。现在不再依赖系统听写快捷键。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While Studio runs in the background, Mode 1's factory F18 voice key directly triggers Apple speech recognition. The system Dictation shortcut is no longer required."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AhaKey Studioがバックグラウンドで動作している間、Mode 1の出荷時音声キーのF18でAppleの音声認識を直接起動します。これでシステムの音声入力ショートカットは不要です。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只要 AhaKey Studio 在背景執行，Mode 1 出廠語音鍵發出的 F18 就會被直接接管到蘋果原生轉寫。現在不再依賴系統聽寫快捷鍵。"
          }
        }
      }
    },
