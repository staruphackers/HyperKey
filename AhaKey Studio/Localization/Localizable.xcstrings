        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証済みですが、現在のシステムBluetoothがオフになっています。コントロールセンターまたはシステム設定でオンにしてください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已授權，但系統藍牙當前關閉，請在控制中心或系統設定中開啟。"
          }
        }
      }
    },
    "text.2b9074c1614f": {
      "comment": "AhaKeyStudioView — 当前是旧协议固件，0x91 会假返回成功但不改灯；请先刷新固件。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前是旧协议固件，0x91 会假返回成功但不改灯；请先刷新固件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This firmware uses the old protocol: 0x91 returns a false success without changing the lights. Update the firmware first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、古いプロトコルファームウェアです。0x91は正常に戻るように見えますが、点灯は変わりません。まずファームウェアを更新してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前是舊協議韌體，0x91 會假返回成功但不改燈；請先重新整理韌體。"
          }
        }
      }
    },
    "text.2ba5ce328314": {
      "comment": "AgentManager — 在 %@ 中未发现 AhaKey Codex hook 标记块。",
      "extractionState": "manual",
