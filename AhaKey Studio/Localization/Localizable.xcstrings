          "stringUnit": {
            "state": "translated",
            "value": "优先用来触发语音输入，用户在软件里看到的是语音软件名，底层仍写成快捷键。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Primarily triggers voice input. The app shows the voice software name while storing a keyboard shortcut underneath."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "主に音声入力のトリガーに使用されます。アプリには音声ソフトウェア名が表示されますが、内部ではキーボードショートカットとして保存されます。"
          }
