      }
    },
    "text.9a7bc446ba51": {
      "comment": "AhaKeyStudioView — 硬性限制：源文件 ≤ 2 MB，FPS 1–30，单模式最多 70 帧；Mode 1/2/3/4 固定写入 slot 10/80/150/220。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "硬性限制：源文件 ≤ 2 MB，FPS 1–30，单模式最多 70 帧；Mode 1/2/3/4 固定写入 slot 10/80/150/220。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Limits: source ≤ 2 MB, FPS 1–30, up to 70 frames per mode. Modes 1/2/3/4 use fixed slots 10/80/150/220."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "制限事項：ソースファイル ≤ 2 MB、FPS 1〜30、各モード最大70フレーム。Mode 1/2/3/4は固定スロット10/80/150/220を使用します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "硬性限制：原始檔 ≤ 2 MB，FPS 1–30，單模式最多 70 影格；Mode 1/2/3/4 固定寫入 slot 10/80/150/220。"
          }
        }
      }
    },
