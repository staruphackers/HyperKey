    "text.6a50e968930c": {
      "comment": "UnifiedAhaKeyOnboardingView — 引导分两步授权：先完成系统弹窗确认的权限，再前往系统设置开启其余权限，最后体验输入。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "引导分两步授权：先完成系统弹窗确认的权限，再前往系统设置开启其余权限，最后体验输入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First allow system permission requests, then enable the remaining permissions in System Settings and try voice input."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "二段階の認証ガイド：まずシステムポップアップで権限を確認し、次にシステム設定から他の権限をオンにして、最後に入力体験します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "引導分兩步授權：先完成系統彈出視窗確認的權限，再前往系統設定開啟其餘權限，最後體驗輸入。"
          }
        }
      }
    },
