    "text.1d2afc21570e": {
      "comment": "OLEDFrameEncoder — 图片源文件约 %@，超过单文件上限 %@。请压缩分辨率、减少帧数或缩短动图后再试。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片源文件约 %@，超过单文件上限 %@。请压缩分辨率、减少帧数或缩短动图后再试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source image is about %@, exceeding the %@ file limit. Reduce resolution, frame count or animation length and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像ソースファイルは約 %@、単一ファイルの上限 %@ を超えています。解像度を圧縮したり、フレーム数を減らしたり、動画を短縮してからもう一度試してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖片原始檔約 %@，超過單檔案上限 %@。請壓縮解析度、減少影格數或縮短動圖後再試。"
          }
        }
      }
    },
