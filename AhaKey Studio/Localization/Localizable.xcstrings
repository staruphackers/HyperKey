    "text.19c27ccf7186": {
      "comment": "AhaKeyStudioView — 点击状态会在虚拟键盘预览，并通过 0x91 临时预览到设备；保存请使用底部通用按钮。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击状态会在虚拟键盘预览，并通过 0x91 临时预览到设备；保存请使用底部通用按钮。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a status to preview it on the virtual keyboard and temporarily on the device via 0x91. Use the bottom action button to save."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステータスを選択すると、仮想キーボードのプレビューと0x91経由のデバイス一時プレビューに表示されます。保存するには、下部のアクションボタンを使用してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點選狀態會在虛擬鍵盤預覽，並通過 0x91 臨時預覽到裝置；儲存請使用底部通用按鈕。"
          }
        }
      }
    },
