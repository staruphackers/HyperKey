    "text.77e783bc51f4": {
      "comment": "AhaKeyFirmwareFlasher — Intel HEX 第 %@ 行使用了不支持的记录类型 0x%@。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Intel HEX 第 %@ 行使用了不支持的记录类型 0x%@。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Intel HEX line %@ uses unsupported record type 0x%@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Intel HEXの%@行はサポートされていない記録タイプ0x%@を使用しました。"
          }
        },
        "zh-Hant": {
