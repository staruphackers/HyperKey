    "text.fa48dd75aff1": {
      "comment": "AhaKeyStudioView — 在「系统设置 > 键盘 > 听写」里开启听写，保证系统语音组件完整可用。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在「系统设置 > 键盘 > 听写」里开启听写，保证系统语音组件完整可用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Dictation in System Settings > Keyboard > Dictation so system speech components are available."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム設定 > キーボード > 音声入力」で音声入力を有効にし、システムの音声コンポーネントを利用できるようにします。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「系統設定 > 鍵盤 > 聽寫」裡開啟聽寫，保證系統語音元件完整可用。"
          }
        }
      }
    },
