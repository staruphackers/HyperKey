    "text.cb22b76447bd": {
      "comment": "DeviceInfoView — 当前选择由 hyperkey-agent 占用蓝牙。请先在上方「蓝牙连接」切到 AhaKey Studio，或点击顶栏「设备信息 · Agent」切换。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前选择由 hyperkey-agent 占用蓝牙。请先在上方「蓝牙连接」切到 AhaKey Studio，或点击顶栏「设备信息 · Agent」切换。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "hyperkey-agent currently owns Bluetooth. Select AhaKey Studio under Bluetooth Connection above, or open Device Information · Agent from the toolbar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の選択は hyperkey-agent によってBluetoothを占有しています。まず上部の「Bluetooth接続」でAhaKey Studioに切り替えるか、トップバーの「デバイス情報 · Agent」をクリックして切り替えてください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前選擇由 hyperkey-agent 佔用藍牙。請先在上方「藍牙連線」切到 AhaKey Studio，或點選頂欄「裝置資訊 · Agent」切換。"
          }
        }
      }
