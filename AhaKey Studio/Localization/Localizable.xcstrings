    "text.5fb7cd34cc29": {
      "comment": "AhaKeyStudioView — 1. 点「现在申请权限」，按系统弹窗允许蓝牙、麦克风和语音转写。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 点「现在申请权限」，按系统弹窗允许蓝牙、麦克风和语音转写。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Select Request Permissions Now and allow Bluetooth, microphone and speech recognition in the system dialogs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1.「今すぐ権限を許可」を選択し、システムダイアログでBluetooth、マイク、音声認識を許可してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 點「現在申請權限」，按系統彈出視窗允許藍牙、麥克風和語音轉寫。"
          }
        }
      }
    },
