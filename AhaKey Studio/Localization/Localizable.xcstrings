    "text.9b9bf5a2d127": {
      "comment": "AgentManager — Codex Hooks：已尝试写入 %@，但校验时未发现 AhaKey 标记块。请确认对「用户主目录 /.codex」有写权限，或关闭占用该文件的其它程序。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex Hooks：已尝试写入 %@，但校验时未发现 AhaKey 标记块。请确认对「用户主目录 /.codex」有写权限，或关闭占用该文件的其它程序。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex Hooks: attempted to write %@, but verification could not find the AhaKey block. Check write access to ~/.codex or close other apps using the file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex Hooks：%@への書き込みを試みましたが、検証時にAhaKeyマークブロックが見つかりませんでした。「ユーザー主ディレクトリ /.codex」に書き込み権限があることを確認するか、このファイルの占有している他のプログラムを停止してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex Hooks：已嘗試寫入 %@，但校驗時未發現 AhaKey 標記塊。請確認對「使用者主目錄 /.codex」有寫權限，或關閉佔用該檔案的其它程式。"
          }
        }
      }
    },
