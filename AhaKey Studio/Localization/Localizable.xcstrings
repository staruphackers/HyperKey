    "text.817ec10e7df1": {
      "comment": "VoiceRelayService — 后台监听已启动。Fn/Globe 语音走 F19；macOS 原生与旧版 F18 会继续兼容。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台监听已启动。Fn/Globe 语音走 F19；macOS 原生与旧版 F18 会继续兼容。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background monitoring started. Fn/Globe uses F19; macOS speech and legacy F18 remain supported."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンド監視を開始しました。Fn/GlobeはF19を使用します。macOSの音声入力と旧式のF18にも対応しています。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "背景監聽已啟動。Fn/Globe 語音走 F19；macOS 原生與舊版 F18 會繼續相容。"
          }
        }
      }
    },
