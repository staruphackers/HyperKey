    "text.14a0e2a6c959": {
      "comment": "AhaKeyStudioView — 当前为组合键（%@）。若你只想发单键 Enter，勿打开 ⌘/⌃ 等，或点「清除修饰键」后再选 Enter。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前为组合键（%@）。若你只想发单键 Enter，勿打开 ⌘/⌃ 等，或点「清除修饰键」后再选 Enter。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a shortcut (%@). To send Enter alone, turn off modifiers such as ⌘/⌃, or select Clear Modifiers and then Enter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、組み合わせキー（%@）です。単一キー Enter を送信したい場合は、⌘/⌃ を開かないでください。または、「修飾キーをクリア」をクリックしてから Enter を選択してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前為組合鍵（%@）。若你只想發單鍵 Enter，勿開啟 ⌘/⌃ 等，或點「清除修飾鍵」後再選 Enter。"
          }
        }
      }
    },
