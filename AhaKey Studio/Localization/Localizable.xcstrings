    "text.2ecb45a3b309": {
      "comment": "AhaKeyStudioView — 拨杆在 IDE 中生效需先安装 Agent 与 Hook，并把蓝牙交给 Agent；否则仅为状态显示。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拨杆在 IDE 中生效需先安装 Agent 与 Hook，并把蓝牙交给 Agent；否则仅为状态显示。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To control IDE approval, install the Agent and hooks and hand Bluetooth to the Agent. Otherwise this only displays status."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "IDEの許可操作を制御するには、AgentとHookを先にインストールし、BluetoothをAgentに渡す必要があります。それ以外は状態表示のみとなります。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撥桿在 IDE 中生效需先安裝 Agent 與 Hook，並把藍牙交給 Agent；否則僅為狀態顯示。"
          }
        }
      }
    },
