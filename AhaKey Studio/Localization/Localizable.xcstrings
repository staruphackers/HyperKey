    "text.4aa536aa1af7": {
      "comment": "AgentManager — 应用包内没有可执行的 hyperkey-agent（路径：…/Contents/MacOS/hyperkey-agent）。请确认发版脚本已把该二进制一并打进 .app；仅有主程序时无法安装守护进程。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用包内没有可执行的 hyperkey-agent（路径：…/Contents/MacOS/hyperkey-agent）。请确认发版脚本已把该二进制一并打进 .app；仅有主程序时无法安装守护进程。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app bundle has no executable hyperkey-agent at Contents/MacOS/hyperkey-agent. Install the full app containing this binary; the main executable alone cannot install the daemon."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリケーションパッケージ内に実行可能な hyperkey-agent（パス：…/Contents/MacOS/hyperkey-agent）はありません。配布スクリプトが当該バイナリを .app に同時に書き込んだことを確認してください。メインプログラムが起動していない場合、ガードプロセスをインストールできません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用包內沒有可執行的 hyperkey-agent（路徑：…/Contents/MacOS/hyperkey-agent）。請確認發版指令碼已把該二進位制一併打進 .app；僅有主程式時無法安裝常駐程式。"
          }
        }
      }
    },
