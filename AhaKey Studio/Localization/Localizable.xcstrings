    "text.1386c39d0d21": {
      "comment": "AhaKeyStudioView — 连接超时，本次未写入键盘；已释放蓝牙给 Agent，可再次进入编辑后重试保存。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接超时，本次未写入键盘；已释放蓝牙给 Agent，可再次进入编辑后重试保存。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection timed out. Nothing was written; Bluetooth has been returned to the Agent. Enter editing again to retry saving."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続が遅延し、今回はキーボードに書き込まれませんでした。AgentにBluetoothを解放したので、編集に戻って再度保存を試すことができます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線超時，本次未寫入鍵盤；已釋放藍牙給 Agent，可再次進入編輯後重試儲存。"
          }
        }
      }
    },
    "text.13c0eea078d7": {
      "comment": "DeviceInfoView — 写 cli-config（CLI）与 permissions.json 的 terminalAllowlist（Agent TUI「Not in allowlist」层）；分见官方文档。均先备份为 .ahakey.bak。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写 cli-config（CLI）与 permissions.json 的 terminalAllowlist（Agent TUI「Not in allowlist」层）；分见官方文档。均先备份为 .ahakey.bak。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates cli-config (CLI) and terminalAllowlist in permissions.json (the Agent TUI “Not in allowlist” layer). See their respective documentation. Both files are backed up as .ahakey.bak first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cli-config（CLI）とpermissions.jsonのterminalAllowlist（Agent TUI「Not in allowlist」層）を更新します。各ファイルの公式ドキュメントを参照してください。両ファイルとも事前に.ahakey.bakへバックアップされます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "寫 cli-config（CLI）與 permissions.json 的 terminalAllowlist（Agent TUI「Not in allowlist」層）；分見官方文件。均先備份為 .ahakey.bak。"
          }
        }
      }
    },
