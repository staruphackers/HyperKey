    "text.3139cb04466d": {
      "comment": "AgentManager — 请点「查看日志」检查 %@；并确认系统「隐私与安全性」中已允许本应用使用蓝牙；若通过 LaunchAgent 拉起 agent 子进程，也需为同一签名的二进制授权。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请点「查看日志」检查 %@；并确认系统「隐私与安全性」中已允许本应用使用蓝牙；若通过 LaunchAgent 拉起 agent 子进程，也需为同一签名的二进制授权。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select View Logs to inspect %@. Allow Bluetooth for this app in Privacy & Security. An Agent launched through LaunchAgent also needs permission for its signed binary."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ログを確認」をクリックして %@ を確認してください。また、システム「プライバシーとセキュリティ」で本アプリケーションがBluetoothを使用することを許可していることを確認してください。LaunchAgent を通じて agent 子プロセスを開始した場合も、同じ署名されたバイナリ認証が必要です。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請點「檢視日誌」檢查 %@；並確認系統「隱私與安全性」中已允許本應用使用藍牙；若通過 LaunchAgent 拉起 agent 子程式，也需為同一簽名的二進位制授權。"
          }
        }
      }
    },
    "text.3211dee7be98": {
      "comment": "AhaKeyBLEManager — Agent 占用中",
      "extractionState": "manual",
      "localizations": {
