    "text.d496441b16ac": {
      "comment": "FirmwareFlasherView — App 会先校验每条 Intel HEX 记录及 SHA-256；确认前不会访问设备。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 会先校验每条 Intel HEX 记录及 SHA-256；确认前不会访问设备。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app validates every Intel HEX record and its SHA-256 before accessing the device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appはまず各Intel HEXレコードとSHA-256を検証します。確認する前にデバイスにアクセスしません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 會先校驗每條 Intel HEX 記錄及 SHA-256；確認前不會存取裝置。"
          }
        }
      }
    },
