    "text.b200d50294b2": {
      "comment": "AhaKeyStudioView — 外发 / DMG / Xcode：默认正式包在系统「隐私与安全性」里显示为「AhaKey Studio」；用 Xcode 以 Debug 运行本工程时显示为「AhaKey Studio（调试）」，请按名称分别授权。路径或签名不同也会被系统当成另一款 App。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外发 / DMG / Xcode：默认正式包在系统「隐私与安全性」里显示为「AhaKey Studio」；用 Xcode 以 Debug 运行本工程时显示为「AhaKey Studio（调试）」，请按名称分别授权。路径或签名不同也会被系统当成另一款 App。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Release/DMG builds appear as AhaKey Studio in Privacy & Security. Xcode Debug builds appear as AhaKey Studio（调试）. Grant access to the matching name. Different paths or signatures may be treated as separate apps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外部配布 / DMG / Xcode：デフォルトではシステム「プライバシーとセキュリティ」に正式パッケージとして「AhaKey Studio」として表示されます。Xcodeで本プロジェクトをデバッグして実行すると「AhaKey Studio（デバッグ）」として表示されますので、名前に応じてそれぞれ認可してください。パスまたは署名が異なる場合でもシステムは別のAppとして扱われます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "外發 / DMG / Xcode：預設正式包在系統「隱私與安全性」裡顯示為「AhaKey Studio」；用 Xcode 以 Debug 執行本工程時顯示為「AhaKey Studio（除錯）」，請按名稱分別授權。路徑或簽名不同也會被系統當成另一款 App。"
          }
        }
      }
    },
