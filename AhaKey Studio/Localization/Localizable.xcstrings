          "stringUnit": {
            "state": "translated",
            "value": "復旧方法：USB ISP接続を維持し、ファームウェアが有効であることを確認してから、フル書き込みをもう一度実行してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復建議：保持 USB ISP 連線，確認韌體有效後重新執行全量燒錄。"
          }
        }
      }
