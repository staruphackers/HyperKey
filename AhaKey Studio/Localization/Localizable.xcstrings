          "stringUnit": {
            "state": "translated",
            "value": "最新固件 0x91 已用于灯效预览；虚拟拨杆只影响 Hook auto-approve，不再写键盘 sw_state。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current firmware uses 0x91 for lighting previews. The virtual switch affects hook auto-approval only and no longer writes keyboard sw_state."
