    "text.640508d26330": {
      "comment": "AhaKeyBLEManager — 当前键盘是旧灯效协议固件（设备回报 v%@.%@，亮度字段 %@），不会执行 0x84/0x85/0x91。请先刷入 2026-06-22 后的新固件，本次未上报写入成功。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前键盘是旧灯效协议固件（设备回报 v%@.%@，亮度字段 %@），不会执行 0x84/0x85/0x91。请先刷入 2026-06-22 后的新固件，本次未上报写入成功。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This keyboard uses the old lighting protocol (reported v%@.%@, brightness field %@) and cannot execute 0x84/0x85/0x91. Install firmware from after June 22, 2026. No write success was reported."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のキーボードは旧ライトエフェクトプロトコルのファームウェア（デバイス報告 v%@.%@、輝度フィールド %@）であり、0x84/0x85/0x91を実行できません。2026年6月22日以降の新しいファームウェアを書き込んでください。今回は書き込み成功が報告されませんでした。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前鍵盤是舊燈效協議韌體（裝置回報 v%@.%@，亮度欄位 %@），不會執行 0x84/0x85/0x91。請先刷入 2026-06-22 後的新韌體，本次未上報寫入成功。"
          }
        }
      }
    },
