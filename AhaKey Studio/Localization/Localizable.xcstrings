    "text.9485f0a680d2": {
      "comment": "AhaKeyStudioModels — 调用苹果原生语音转写，识别完成后以 ⌘V 写回当前光标位置。适合 Claude Code、Kimi Code、Codex 等 CLI 终端及任意输入框。按一次开始，再按一次结束。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调用苹果原生语音转写，识别完成后以 ⌘V 写回当前光标位置。适合 Claude Code、Kimi Code、Codex 等 CLI 终端及任意输入框。按一次开始，再按一次结束。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses Apple speech recognition and pastes the result at the cursor with ⌘V. Works in Claude Code, Kimi Code, Codex and other text fields. Press once to start and again to stop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleの音声認識を使用し、認識結果を⌘Vでカーソル位置に貼り付けます。Claude Code、Kimi Code、CodexなどのCLI端末やその他の入力欄で使用できます。1回押すと開始し、もう一度押すと停止します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "呼叫蘋果原生語音轉寫，識別完成後以 ⌘V 寫回當前游標位置。適合 Claude Code、Kimi Code、Codex 等 CLI 終端及任意輸入框。按一次開始，再按一次結束。"
          }
        }
      }
    },
